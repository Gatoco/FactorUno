# Copiar a .env y ajustar antes de desplegar (docker compose lo lee automáticamente).
# El archivo .env NO se versiona.

# Secreto de firma de los tokens JWT (mínimo 32 caracteres aleatorios en producción)
FACTORUNO_SECRET=cambiar-por-secreto-largo-aleatorio

# Contraseñas de los usuarios semilla (se aplican al crear la base por primera vez)
FACTORUNO_ADMIN_PASSWORD=Admin1234!
FACTORUNO_ANALISTA_PASSWORD=Analista1234!
FACTORUNO_CONSULTA_PASSWORD=Consulta1234!

# Horas de validez del token
FACTORUNO_TOKEN_HORAS=8

# Orígenes CORS permitidos, separados por coma (vacío = solo desarrollo local)
FACTORUNO_CORS_ORIGINS=http://localhost:5173
