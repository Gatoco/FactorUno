# Copiar a .env y ajustar antes de desplegar (docker compose lo lee automáticamente).
# El archivo .env NO se versiona.

# Secreto de firma de los tokens JWT (OBLIGATORIO; generar con: openssl rand -hex 32)
FACTORUNO_SECRET=

# Usuarios semilla de demostración (opcionales): se crean al inicializar la base
# solo si FACTORUNO_SEED_DEMO=1 y la contraseña correspondiente está definida.
FACTORUNO_SEED_DEMO=0
FACTORUNO_ADMIN_PASSWORD=
FACTORUNO_ANALISTA_PASSWORD=
FACTORUNO_CONSULTA_PASSWORD=

# Horas de validez del token
FACTORUNO_TOKEN_HORAS=8

# Orígenes CORS permitidos, separados por coma (vacío = solo desarrollo local)
FACTORUNO_CORS_ORIGINS=http://localhost:5173

# Integraciones AWS (opcionales): espejo de auditoría en DynamoDB
FACTORUNO_DYNAMO_TABLA=

# Bucket S3 para exportes JSON/CSV con URL firmada
FACTORUNO_S3_BUCKET=
